{
    "version": 2,
    "builds": [
        {
            "src": "apps/api/vercel.json",
            "use": "@vercel/node"
        },
        {
            "src": "apps/web/vercel.json",
            "use": "@vercel/static-build"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/apps/api/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/apps/web/$1"
        }
    ]
}