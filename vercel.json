git commit -m "Final vercel.json fix - valid JSON syntax"
git push origin main
{
    "version": 2,
    "builds": [
        {
            "src": "apps/api/package.json",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "apps/api/prisma/**"
                ]
            }
        },
        {
            "src": "apps/web/vite.config.ts",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "apps/web/dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/apps/api/src/server.js"
        },
        {
            "src": "/(.*)",
            "dest": "/apps/web/index.html"
        }
    ]
}