{
    "env":  {
                "NODE_ENV":  "production"
            },
    "builds":  [
                   {
                       "config":  {
                                      "memory":  1024,
                                      "maxLambdaSize":  "50mb"
                                  },
                       "use":  "@vercel/node",
                       "src":  "apps/api/dist/server.js"
                   },
                   {
                       "src":  "apps/web/dist/**",
                       "use":  "@vercel/static"
                   }
               ],
    "headers":  [
                    {
                        "headers":  [
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        }
                                    ],
                        "source":  "/(.*)"
                    }
                ],
    "routes":  [
                   {
                       "src":  "/api/(.*)",
                       "dest":  "apps/api/dist/server.js"
                   },
                   {
                       "dest":  "apps/web/dist/index.html",
                       "continue":  false,
                       "src":  "/(.*)"
                   }
               ],
    "version":  2
}
