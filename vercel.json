{
    "version": 2,
    "builds": [
        {
            "src": "apps/api/dist/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "apps/web/out/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "apps/api/dist/server.js"
        },
        {
            "src": "/(.*)",
            "dest": "apps/web/out/$1"
        }
    ]
}