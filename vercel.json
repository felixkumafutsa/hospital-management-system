{
    "version": 2,
    "builds": [
        {
            "src": "apps/api/package.json",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "apps/api/prisma/**"
                ]
            }
        },
        {
            "src": "apps/web/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "apps/web/dist"
            }
        }
    ],
    "engines": {
        "node": "22.x"
    },
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/apps/api/src/server.js"
        },
        {
            "src": "/(.*)",
            "dest": "/apps/web/$1"
        }
    ]
}