{
  "name": "betterlife-hms-api",
  "version": "1.0.0",
  "description": "Better Life Private Clinic HMS Backend API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0 <26.0.0"
  },
  "scripts": {
    "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register\" src/server.ts",
    "build": "prisma generate && npx tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate-roles": "ts-node prisma/migration-script.ts",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed/index.ts",
    "clear-data": "ts-node prisma/clear-data.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.prisma\"",
    "test:journey": "node test-clinic-journey.js",
    "test": "jest"
  },
  "dependencies": {
    "@packages/types": "*",
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "dotenv": "^17.4.2",
    "express": "^5.0.0-beta.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "sharp": "^0.33.2",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed/index.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.19",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "jest": "^30.5.1",
    "nodemon": "^3.0.3",
    "prisma": "^5.10.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}