# Copy scripts/Initialize-LocalDeployment.ps1 to generate an ignored .env with unique secrets.
# Values below are examples only and must not be used for a real installation.
POSTGRES_DB=betterlife
POSTGRES_USER=betterlife_app
POSTGRES_PASSWORD=replace_with_a_random_hex_password
DATABASE_URL=postgresql://betterlife_app:replace_with_a_random_hex_password@db:5432/betterlife?schema=public
JWT_PRIVATE_KEY=replace_with_at_least_32_random_bytes
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
NODE_ENV=production
PORT=4000
HTTPS_PORT=443
LOG_LEVEL=info
CORS_ORIGIN=
